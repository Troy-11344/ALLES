{%- comment -%} Category tabs over a sideways row of dishes, as on sweetgreen. Each block is a collection. {%- endcomment -%}
<section class="wrap menu" id="menu" data-menu>
  <div class="menu-head reveal">
    <div>
      <div class="caps accent">{{ section.settings.eyebrow }}</div>
      <h2 class="display">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="prose">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <a class="link" href="{{ section.settings.all_url | default: routes.all_products_collection_url }}">{{ section.settings.all_label }}</a>
  </div>
  {%- if section.blocks.size > 1 -%}
    <div class="tabs reveal" role="tablist" aria-label="Menu categories">
      {%- for block in section.blocks -%}
        <button class="tab caps" role="tab" type="button" id="tab-{{ block.id }}" aria-selected="{% if forloop.index == section.settings.open_tab %}true{% else %}false{% endif %}" data-cat="{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title }}</button>
      {%- endfor -%}
    </div>
  {%- endif -%}
  <div class="rail-wrap">
    <div class="rail-ui">
      <button class="round" type="button" data-rail-prev aria-label="{{ 'accessibility.scroll_left' | t }}">←</button>
      <button class="round" type="button" data-rail-next aria-label="{{ 'accessibility.scroll_right' | t }}">→</button>
    </div>
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      <div class="rail" role="tabpanel" aria-labelledby="tab-{{ block.id }}" data-cat="{{ block.id }}" {% unless forloop.index == section.settings.open_tab %}hidden{% endunless %}>
        {%- if col.products.size > 0 -%}
          {%- for product in col.products limit: section.settings.limit -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} No products yet: show the brand photos so the section reads right in the editor. {%- endcomment -%}
          {%- assign demo = 'brand-green.jpg,brand-tomato.jpg,brand-zucchini.jpg,brand-vine.jpg' | split: ',' -%}
          {%- assign names = 'Green Herb Crêpes,Heirloom Tomato,Market Vegetables,Vine Tomato Salad' | split: ',' -%}
          {%- for img in demo -%}
            <article class="card">
              <div class="ph"><img src="{{ img | asset_url }}" alt="" loading="lazy" width="960" height="1200"><span class="btn light add" aria-disabled="true">{{ 'general.add' | t }}</span></div>
              <div class="top"><h3>{{ names[forloop.index0] }}</h3><span class="price caps">$—</span></div>
              <p class="desc">{{ 'collections.empty' | t }}</p>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  {%- if settings.allergy_note != blank -%}<p class="note">{{ settings.allergy_note }}</p>{%- endif -%}
</section>

{% schema %}
{
  "name": "Menu showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line", "default": "The Menu" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Made each morning." },
    { "type": "text", "id": "text", "label": "Text", "default": "A short menu that changes with the market. Every dish is served the way the kitchen made it." },
    { "type": "text", "id": "all_label", "label": "Link text", "default": "View the full menu" },
    { "type": "url", "id": "all_url", "label": "Link goes to" },
    { "type": "range", "id": "limit", "label": "Dishes per category", "min": 3, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "open_tab", "label": "Category open at first", "min": 1, "max": 5, "step": 1, "default": 2 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Tab name", "info": "Leave empty to use the collection's name." }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Menu showcase",
      "blocks": [
        { "type": "category", "settings": { "label": "Morning" } },
        { "type": "category", "settings": { "label": "Midday" } },
        { "type": "category", "settings": { "label": "Sweet" } }
      ]
    }
  ]
}
{% endschema %}
