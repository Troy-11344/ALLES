{%- comment -%} Photo beside a kicker, headline and one link. The photo drifts against the scroll. {%- endcomment -%}
<section class="feature{% if section.settings.flip %} flip{% endif %}" id="{{ section.settings.anchor | default: 'story' }}">
  <div class="inner reveal">
    <div class="pic">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(max-width: 960px) 100vw, 55vw', widths: '700, 1100, 1600' }}
      {%- else -%}
        <img src="{{ 'brand-cups.jpg' | asset_url }}" alt="" loading="lazy" width="1080" height="1351">
      {%- endif -%}
    </div>
    <div class="copy">
      {%- if section.settings.show_mark -%}<span class="illo" aria-hidden="true">{% render 'logo-illustration' %}</span>{%- endif -%}
      <div class="caps accent">{{ section.settings.eyebrow }}</div>
      <h2 class="display">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="prose">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="link" href="{{ section.settings.link_url | default: settings.social_instagram }}"{% if section.settings.link_url == blank %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kitchen feature",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "checkbox", "id": "flip", "label": "Photo on the right", "default": false },
    { "type": "checkbox", "id": "show_mark", "label": "Show the illustration", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Small line", "default": "In the Kitchen" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Everyday food, served with ceremony." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Allés cooks the way you would for a guest: real butter, fruit at its best and a silver tray for the office lunch. The kitchen opens its doors on Instagram first.</p>" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Follow @eat.alles" },
    { "type": "url", "id": "link_url", "label": "Link goes to", "info": "Leave empty for Instagram." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "story" }
  ],
  "presets": [{ "name": "Kitchen feature" }]
}
{% endschema %}
