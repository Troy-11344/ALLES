{%- comment -%} The page visitors see while the store is locked. {%- endcomment -%}
<div class="wrap page-head" style="min-height:70vh;justify-content:center;align-items:center;text-align:center">
  <span class="brand">{% render 'logo-wordmark' %}</span>
  <span class="script" style="font-family:var(--script);font-size:2.4rem">Coming Soon</span>
  <h1 class="display">{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p class="prose">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'pill-form', style: 'max-width:420px;width:100%' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" required>
    <button class="round" type="submit" aria-label="{{ 'newsletter.button' | t }}">→</button>
  {%- endform -%}
  <details style="margin-top:24px">
    <summary class="caps" style="cursor:pointer">Enter with password</summary>
    {%- form 'storefront_password', class: 'pill-form', style: 'margin-top:12px' -%}
      <input type="password" name="password" placeholder="Password" required>
      <button class="round" type="submit" aria-label="Enter">→</button>
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Headline", "default": "Feeding Society Daily. Opening in Atlanta." }
  ]
}
{% endschema %}
