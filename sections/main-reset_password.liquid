<div class="wrap page-head account"><h1 class="display">Choose a new password</h1></div>
<div class="wrap page-body account">
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label class="caps" for="ResetPassword">{{ 'customer.register.password' | t }}</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label class="caps" for="ResetConfirm">Confirm password</label><input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <div class="buy"><button class="btn" type="submit">Save password</button></div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Reset password"
}
{% endschema %}
