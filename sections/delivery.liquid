{%- comment -%}
  "Ways to order": delivery partners, direct catering and the kitchen note. Allés cooks from a shared
  kitchen with no walk-in counter yet, so this section replaces a locations list. Partner links come
  from theme settings (Delivery partners) so one paste fills every section that uses them.
{%- endcomment -%}
<section class="work ways" id="delivery">
  <div class="wrap">
    <div class="lead reveal">
      {%- if section.settings.eyebrow != blank -%}<div class="caps accent">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if request.page_type == 'page' and section.settings.heading == blank -%}
        <h1 class="display">{{ page.title }}</h1>
      {%- elsif request.page_type == 'page' -%}
        <h1 class="display">{{ section.settings.heading }}</h1>
      {%- else -%}
        <h2 class="display">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}<p class="prose">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" style="align-self:start">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    <ul class="reveal">
      {%- for block in section.blocks -%}
        {%- liquid
          case block.settings.source
            when 'uber_eats'
              assign url = settings.uber_eats_url
            when 'doordash'
              assign url = settings.doordash_url
            when 'catering'
              assign url = settings.catering_url | default: pages.catering.url
            when 'menu'
              assign url = routes.all_products_collection_url
            else
              assign url = block.settings.url
          endcase
          assign external = false
          if block.settings.source == 'uber_eats' or block.settings.source == 'doordash'
            assign external = true
          endif
        -%}
        <li{% if url == blank %} class="soon"{% endif %} {{ block.shopify_attributes }}>
          {%- if url != blank -%}
            <a href="{{ url }}"{% if external %} target="_blank" rel="noopener"{% endif %}>
              <strong>{{ block.settings.title }}</strong>
              <span class="round" aria-hidden="true">→</span>
              {%- if block.settings.text != blank -%}<span class="sub">{{ block.settings.text }}</span>{%- endif -%}
            </a>
          {%- else -%}
            <div>
              <strong>{{ block.settings.title }}</strong>
              <span class="tag caps accent">{{ 'delivery.coming' | t }}</span>
              {%- if block.settings.text != blank -%}<span class="sub">{{ block.settings.text }}</span>{%- endif -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Ways to order",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line", "default": "Delivery & Catering" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Allés comes to you.", "info": "On the Delivery page, leave empty to use the page title." },
    { "type": "text", "id": "text", "label": "Text", "default": "We cook from our kitchen in Atlanta and deliver, so there is no counter to queue at. Single meals arrive through our delivery partners; the office is served by us directly." },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_url", "label": "Button goes to" },
    { "type": "paragraph", "content": "Paste the Uber Eats and DoorDash store links once under Theme settings, Delivery partners. Until then those rows read \"Coming soon\"." }
  ],
  "blocks": [
    {
      "type": "channel",
      "name": "Way to order",
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "Uber Eats" },
        { "type": "text", "id": "text", "label": "One line", "default": "Lunch and sweet things, delivered across Atlanta." },
        {
          "type": "select", "id": "source", "label": "Link",
          "options": [
            { "value": "uber_eats", "label": "Uber Eats store (theme settings)" },
            { "value": "doordash", "label": "DoorDash store (theme settings)" },
            { "value": "catering", "label": "Plan catering page" },
            { "value": "menu", "label": "The menu" },
            { "value": "custom", "label": "Custom link below" }
          ],
          "default": "custom"
        },
        { "type": "url", "id": "url", "label": "Custom link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Ways to order",
      "blocks": [
        { "type": "channel", "settings": { "title": "Uber Eats", "text": "Single meals and sweet things, delivered across Atlanta.", "source": "uber_eats" } },
        { "type": "channel", "settings": { "title": "DoorDash", "text": "The same menu, on DoorDash.", "source": "doordash" } },
        { "type": "channel", "settings": { "title": "Office Catering", "text": "Breakfast, lunch and coffee for ten to two hundred, delivered and set out by us.", "source": "catering" } },
        { "type": "channel", "settings": { "title": "The Kitchen", "text": "Allés cooks from a shared kitchen in Atlanta. No walk-in counter yet; the first one is coming.", "source": "custom" } }
      ]
    }
  ]
}
{% endschema %}
