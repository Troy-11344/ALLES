{%- comment -%} "Allés for the Office": a plain list of services, as sweetgreen's "for work" block. {%- endcomment -%}
<section class="work" id="catering">
  <div class="wrap">
    <div class="lead reveal">
      <div class="caps accent">{{ section.settings.eyebrow }}</div>
      <h2 class="display">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="prose">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ section.settings.button_url | default: settings.catering_url }}" style="align-self:start">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    <ul class="reveal">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block.settings.url | default: settings.catering_url }}">
            <strong>{{ block.settings.title }}</strong>
            <span class="round" aria-hidden="true">→</span>
            {%- if block.settings.text != blank -%}<span class="sub">{{ block.settings.text }}</span>{%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Office services",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line", "default": "Allés for the Office" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Lunch, sorted for the whole floor." },
    { "type": "text", "id": "text", "label": "Text", "default": "Order for a meeting of ten or a floor of two hundred. Set out on silver and cleared away after." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Plan catering" },
    { "type": "url", "id": "button_url", "label": "Button goes to" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "Lunch Service" },
        { "type": "text", "id": "text", "label": "One line", "default": "Seasonal plates and salads, served family style. From 10 guests." },
        { "type": "url", "id": "url", "label": "Goes to" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Office services",
      "blocks": [
        { "type": "service", "settings": { "title": "Breakfast Service", "text": "Pastry, fruit, eggs and coffee for early meetings. From 10 guests." } },
        { "type": "service", "settings": { "title": "Lunch Service", "text": "Seasonal plates and salads, served family style. From 10 guests." } },
        { "type": "service", "settings": { "title": "Coffee & Pastry", "text": "An afternoon pause, brought to the room. From 6 guests." } },
        { "type": "service", "settings": { "title": "Team Accounts", "text": "One invoice, set budgets, everyone orders their own." } }
      ]
    }
  ]
}
{% endschema %}
