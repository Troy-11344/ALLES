{%- comment -%} The Allés Letter. Uses Shopify's customer form, so sign-ups land in Customers with marketing consent. {%- endcomment -%}
<section class="letter" id="letter">
  <div class="wrap">
    <div class="copy reveal">
      <h2 class="display">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="prose">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="reveal">
      {%- form 'customer', id: 'NewsletterForm', data-newsletter: '', data-error: 'newsletter.error' | t -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="pill-form">
          <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.label' | t }}</label>
          <input id="NewsletterEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" autocomplete="email" required>
          <button class="round" type="submit" aria-label="{{ 'newsletter.button' | t }}">→</button>
        </div>
        <div class="msg" aria-live="polite">
          {%- if form.posted_successfully? -%}{{ 'newsletter.success' | t }}{%- elsif form.errors -%}{{ form.errors.messages['email'] }}{%- endif -%}
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Headline", "default": "The Allés Letter" },
    { "type": "text", "id": "text", "label": "Text", "default": "Monthly notes from the kitchen: new dishes, opening dates and the occasional invitation." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
