{%- comment -%}
  One dish. Renders from a product; the Add button posts the first available variant to the cart.
  Usage: {% render 'product-card', product: product, loading: 'lazy' %}
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign dietary = product.metafields.alles.dietary.value
-%}
<article class="card">
  <div class="ph">
    <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 800 | image_tag: loading: loading | default: 'lazy', sizes: '(max-width: 560px) 76vw, 25vw', widths: '400, 600, 800' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </a>
    {%- if product.available -%}
      <form class="add" method="post" action="{{ routes.cart_add_url }}" data-add>
        <input type="hidden" name="id" value="{{ variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button class="btn light" type="submit" data-added="{{ 'general.added' | t }}" aria-label="{{ 'products.add_to_order' | t }}: {{ product.title | escape }}">{{ 'general.add' | t }}</button>
      </form>
    {%- else -%}
      <span class="btn light add" aria-disabled="true">{{ 'general.sold_out' | t }}</span>
    {%- endif -%}
  </div>
  <div class="top">
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <span class="price caps">{{ variant.price | money_without_trailing_zeros }}</span>
  </div>
  {%- if product.metafields.alles.ingredients != blank -%}
    <p class="desc">{{ product.metafields.alles.ingredients }}</p>
  {%- elsif product.description != blank -%}
    <p class="desc">{{ product.description | strip_html | truncatewords: 14 }}</p>
  {%- endif -%}
  {%- if dietary -%}
    <div class="diet">{%- for d in dietary -%}<span>{{ d }}</span>{%- endfor -%}</div>
  {%- endif -%}
</article>
